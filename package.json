{
  "name": "multistream-rtmp-server",
  "version": "1.0.0",
  "private": true,
  "description": "A native Node.js RTMP ingest server that relays encoded media to multiple RTMP destinations.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "init-db": "tsx scripts/init-db.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
